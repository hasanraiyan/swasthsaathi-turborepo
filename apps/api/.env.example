# Copy to apps/api/.env and fill in. Never commit the real .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/swasthsaathi
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/swasthsaathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/swasthsaathi

# Clerk keys, from https://dashboard.clerk.com -> API keys.
# The secret key must never appear in the mobile app.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

PORT=3000

# The health assistant. Without a key it refuses to run; everything else works.
OPENAI_API_KEY=
# Defaults: gpt-4o for the conversation, gpt-4o-mini for naming a chat.
OPENAI_MODEL=
OPENAI_TITLE_MODEL=
# Pause before any tool that changes the health record. Set to "false" to let
# the assistant write unprompted -- not recommended.
AGENT_CONFIRM_WRITES=true
# Runs allowed per user per hour. Defaults to 30.
AGENT_RUNS_PER_HOUR=30
# Where SKILL.md directories live. Defaults to <app>/skills.
AGENT_SKILLS_DIR=
