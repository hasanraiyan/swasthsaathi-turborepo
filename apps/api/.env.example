# Copy to apps/api/.env and fill in. Never commit the real .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/swasthsaathi
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/swasthsaathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/swasthsaathi

# Clerk keys, from https://dashboard.clerk.com -> API keys.
# The secret key must never appear in the mobile app.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

PORT=3000
