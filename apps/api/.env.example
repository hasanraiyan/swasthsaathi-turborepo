# Copy to apps/api/.env and fill in. Never commit the real .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/swasthsaathi
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/swasthsaathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/swasthsaathi

# Clerk keys, from https://dashboard.clerk.com -> API keys.
# The secret key must never appear in the mobile app.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

PORT=3000

# The health assistant. Without a key it refuses to run; everything else works.
OPENAI_API_KEY=
# Anything speaking the OpenAI chat API. Leave blank for OpenAI itself.
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1
# Set OPENAI_MODEL too -- a gateway will not have OpenAI's model names, and
# the assistant is nothing but tool calls, so the model must support function
# calling or it will answer without ever reading the health record.
OPENAI_BASE_URL=
# Defaults: gpt-4o for the conversation, gpt-4o-mini for naming a chat.
#   NVIDIA example: meta/llama-3.3-70b-instruct
OPENAI_MODEL=
OPENAI_TITLE_MODEL=
# Pause before any tool that changes the health record. Set to "false" to let
# the assistant write unprompted -- not recommended.
AGENT_CONFIRM_WRITES=true
# Runs allowed per user per hour. Defaults to 30.
AGENT_RUNS_PER_HOUR=30
# Where SKILL.md directories live. Defaults to <app>/skills.
AGENT_SKILLS_DIR=

# How long to wait on the model. Chat is generous -- a hosted gateway can take
# tens of seconds for a tool call, and cutting off a real answer is worse than
# waiting. Titling is not: it must never be why someone waits.
AGENT_CHAT_TIMEOUT_MS=180000
AGENT_TITLE_TIMEOUT_MS=15000
