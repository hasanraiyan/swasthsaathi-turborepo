{
  "expo": {
    "name": "SwasthSaathi",
    "slug": "swasthsaathi",
    "version": "1.0.0",
    "scheme": "swasthsaathi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swasthsaathi.mobile"
    },
    "android": {
      "package": "com.swasthsaathi.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      "expo-font",
      "expo-router",
      "expo-dev-client",
      [
        "expo-audio",
        {
          "microphonePermission": "SwasthSaathi uses your microphone during a voice call with the assistant.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
